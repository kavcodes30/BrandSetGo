# BrandSetGo configuration. Copy to .env (run.bat does this for you).
# Every value below has a working default; you can start with an empty file.

DATABASE_URL=sqlite:///./brandsetgo.db
UPLOAD_DIR=uploads
SEED_ON_STARTUP=false

# ---- sessions ----
# Leave SECRET_KEY empty to generate backend/.secret on first run.
SECRET_KEY=
SESSION_DAYS=7
# Set true on an HTTPS host. Leave false for http://localhost.
COOKIE_SECURE=false
# The first account created becomes the platform admin.
FIRST_USER_IS_ADMIN=true
# Used in password-reset links. Set to your public URL when hosted.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Sarvam AI ----
# Key: set it here, or in the host's env vars, or paste it into backend/sarvam.key.
# Leave all three empty to run deterministically (no external calls).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_REGION=asia-south1 (in)
SARVAM_TIMEOUT=45
SARVAM_MAX_RETRIES=2

# ---- AI layers (each one degrades to the deterministic path on its own) ----
AI_CLASSIFICATION=true
AI_SEMANTIC_REVIEW=true
AI_LEGAL_REVIEW=true
AI_REWRITE=true
AI_RULE_EXTRACTION=true

# ---- mail (optional) ----
# Without SMTP every message still lands in the admin console outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BrandSetGo <no-reply@brandsetgo.local>

# ---- abuse control / runtime ----
RATE_LIMIT_ENABLED=true
LOGIN_ATTEMPTS_PER_MINUTE=10
REVIEWS_PER_MINUTE=20
REVIEW_TIMEOUT_SECONDS=120
